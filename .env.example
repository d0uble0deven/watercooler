# ─────────────────────────────────────────────────────────────────
# Watercooler — environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Slack credentials (get these from https://api.slack.com/apps) ─
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── App ────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated Slack user IDs who can run admin commands.
# Find yours: Slack profile → ⋮ menu → "Copy member ID"
ADMIN_USER_IDS=U01XXXXXXX,U02XXXXXXX

# ── Database ───────────────────────────────────────────────────────
DATABASE_PATH=./data/watercooler.db

# ── Scheduling ─────────────────────────────────────────────────────
# Keep false in local dev to prevent accidental automated runs
SCHEDULING_ENABLED=false
