{
  "name": "watercooler",
  "version": "0.1.0",
  "description": "Internal Slack app for casual 1:1 social matching",
  "main": "src/app.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/app.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/app.js",
    "db:init": "node --disable-warning=ExperimentalWarning scripts/db-init.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/db-reset.js"
  },
  "dependencies": {
    "@slack/bolt": "^3",
    "dotenv": "^16"
  },
  "notes": {
    "sqlite": "Using Node 24's built-in node:sqlite (no install needed, added in Phase 2)"
  }
}
