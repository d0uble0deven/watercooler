{
  "name": "watercooler",
  "version": "0.1.0",
  "description": "Internal Slack app for casual 1:1 social matching",
  "main": "src/app.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/app.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/app.js",
    "db:init": "node --disable-warning=ExperimentalWarning scripts/db-init.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/db-reset.js",
    "test": "node --test --disable-warning=ExperimentalWarning tests/matching.test.js",
    "test:commands": "node --disable-warning=ExperimentalWarning scripts/test-commands.js",
    "test:dry-run": "node --disable-warning=ExperimentalWarning scripts/test-dry-run.js",
    "test:run": "node --disable-warning=ExperimentalWarning scripts/test-run.js",
    "test:admin": "node --disable-warning=ExperimentalWarning scripts/test-admin.js",
    "test:scheduler": "node --disable-warning=ExperimentalWarning scripts/test-scheduler.js",
    "test:cal-connection": "node --disable-warning=ExperimentalWarning scripts/test-calendar-connection.js",
    "test:cal-settings": "node --disable-warning=ExperimentalWarning scripts/test-calendar-settings.js",
    "test:cal-freebusy": "node --disable-warning=ExperimentalWarning scripts/test-calendar-reader.js",
    "test:cal-slot-logic": "node --disable-warning=ExperimentalWarning scripts/test-slot-finder.js",
    "test:cal-email-resolve": "node --disable-warning=ExperimentalWarning scripts/test-calendar-step5.js",
    "test:cal-book-slot": "node --disable-warning=ExperimentalWarning scripts/test-calendar-step6.js",
    "test:cal-create-event": "node --disable-warning=ExperimentalWarning scripts/test-calendar-step7.js",
    "test:cal-tz-display": "node --disable-warning=ExperimentalWarning scripts/test-calendar-step8.js",
    "test:meeting-completion": "node --disable-warning=ExperimentalWarning scripts/test-post-meeting-step1.js",
    "test:meeting-feedback": "node --disable-warning=ExperimentalWarning scripts/test-post-meeting-step2.js",
    "test:round-stats": "node --disable-warning=ExperimentalWarning scripts/test-post-meeting-step4.js",
    "test:completion-message": "node --disable-warning=ExperimentalWarning scripts/test-post-meeting-step5.js",
    "test:fallback-days": "node --disable-warning=ExperimentalWarning scripts/test-post-meeting-step6.js",
    "test:slot-distribution": "node --disable-warning=ExperimentalWarning scripts/test-slot-distribution.js",
    "test:tz-intersection": "node --disable-warning=ExperimentalWarning scripts/test-timezone-intersection.js",
    "test:admin-commands": "node --disable-warning=ExperimentalWarning scripts/test-admin-commands.js",
    "test:reschedule": "node --disable-warning=ExperimentalWarning scripts/test-reschedule.js",
    "test:enrollment": "node --disable-warning=ExperimentalWarning scripts/test-enrollment.js",
    "test:fun-facts": "node --disable-warning=ExperimentalWarning scripts/test-fun-facts.js",
    "test:no-slots": "node --disable-warning=ExperimentalWarning scripts/test-no-slots.js",
    "test:decline": "node --disable-warning=ExperimentalWarning scripts/test-decline-watcher.js",
    "test:all": "npm run test && npm run test:commands && npm run test:dry-run && npm run test:admin && npm run test:scheduler && npm run test:cal-connection && npm run test:cal-settings && npm run test:cal-freebusy && npm run test:cal-slot-logic && npm run test:cal-email-resolve && npm run test:cal-book-slot && npm run test:cal-create-event && npm run test:cal-tz-display && npm run test:meeting-completion && npm run test:slot-distribution && npm run test:tz-intersection && npm run test:admin-commands && npm run test:reschedule && npm run test:enrollment && npm run test:fun-facts && npm run test:no-slots && npm run test:decline"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@slack/bolt": "^3",
    "dotenv": "^16"
  },
  "notes": {
    "sqlite": "Using Node 24's built-in node:sqlite (no install needed, added in Phase 2)"
  }
}
